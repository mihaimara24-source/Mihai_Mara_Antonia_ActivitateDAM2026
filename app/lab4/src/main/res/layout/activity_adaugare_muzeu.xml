<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Adăugare Muzeu Maritim"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/etDenumire"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Denumire Muzeu"
            android:inputType="text"/>

        <EditText
            android:id="@+id/etAn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="An înființare"
            android:inputType="number"/>

        <CheckBox
            android:id="@+id/cbGhid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oferă ghidaj turistic"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categorie bilet:"
            android:layout_marginTop="8dp"/>

        <RadioGroup
            android:id="@+id/rgCategorie"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbStandard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Standard"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbVIP"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP"/>
        </RadioGroup>

        <Button
            android:id="@+id/btnSalveaza"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Salvează"
            android:layout_marginTop="16dp"/>

    </LinearLayout>
</ScrollView>